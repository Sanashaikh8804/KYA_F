{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kya-shield/decision_schema.json",
  "title": "KYA-Shield scoring output",
  "type": "object",
  "properties": {
    "session_id": { "type": "string" },
    "agent_class": { "type": "string", "enum": ["human", "scripted_bot", "llm_agent"] },
    "agent_class_probs": {
      "type": "object",
      "properties": {
        "human": { "type": "number", "minimum": 0, "maximum": 1 },
        "scripted_bot": { "type": "number", "minimum": 0, "maximum": 1 },
        "llm_agent": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "agent_trust_score": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Higher is safer" },
    "p_fraud": { "type": "number", "minimum": 0, "maximum": 1 },
    "action": { "type": "string", "enum": ["allow", "step_up", "hold", "block"] },
    "expected_cost_by_action": {
      "type": "object",
      "properties": {
        "allow": { "type": "number" },
        "step_up": { "type": "number" },
        "hold": { "type": "number" },
        "block": { "type": "number" }
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "description": "Ranked, most important first; never empty (fallback R000)",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "pattern": "^R[0-9]{3}$" },
          "text": { "type": "string" },
          "weight": { "type": "number" }
        },
        "required": ["code", "text"]
      }
    },
    "latency_ms": { "type": "number", "minimum": 0 }
  },
  "required": ["agent_class", "agent_trust_score", "action", "reason_codes", "latency_ms"]
}
